# 마른길 환경변수 예시.
#
#   Copy-Item .env.example .env
#
# .env 는 커밋하지 않는다(.gitignore 등록됨). 이 파일에는 이름과 설명만 두고
# 실제 키·토큰·비밀값은 절대 적지 않는다.

# --- 백엔드 -----------------------------------------------------------------

# 개발 서버 바인딩. 데모는 로컬 전용이므로 기본값을 바꿀 이유가 거의 없다.
MAREUNGIL_API_HOST=127.0.0.1
MAREUNGIL_API_PORT=8000

# 응답에 실을 계약 버전 태그. 계약을 바꾸면 함께 올린다(N-08 추적성).
MAREUNGIL_CONTRACT_VERSION=v1

# 기본 재생 시나리오. contracts/fixtures/demo/ 의 파일명과 같은 ID 를 쓴다.
MAREUNGIL_DEFAULT_SCENARIO=DS-S1

# 배포 환경. production 으로 두면 대화형 API 문서(/docs·/redoc·/openapi.json)를 닫는다.
# 로컬 개발에서는 비워 두거나 development 로 둔다 — 문서가 있어야 손으로 찔러 볼 수 있다.
MAREUNGIL_ENV=development

# 브라우저에서 이 API 를 부를 수 있는 출처(쉼표 구분).
#
# 비워 두면 로컬 개발 주소(127.0.0.1:5173 / :4173 과 localhost 짝)만 허용한다.
# **배포하면 반드시 프론트 도메인을 적어야 한다** — 안 적으면 CORS 로 막힌다.
#
#   MAREUNGIL_CORS_ORIGINS=https://mareungil.vercel.app
#
# 정말 전부 열어야 하면 * 하나만 적어 명시적으로 연다. 코드 기본값에 숨겨 두지 않는다.
MAREUNGIL_CORS_ORIGINS=

# Vercel 프리뷰처럼 도메인이 매번 바뀌는 배포만 정규식으로 함께 허용한다.
#
#   MAREUNGIL_CORS_ORIGIN_REGEX=https://mareungil-.*\.vercel\.app
MAREUNGIL_CORS_ORIGIN_REGEX=

# 한 IP 가 MAREUNGIL_RATE_WINDOW_SEC 초 동안 보낼 수 있는 요청 수. 0 이면 끈다.
#
# 기본값 60회/60초는 사람이 쓰다가 걸릴 일이 없는 값이다 — 화면 하나가 움직일 때
# API 를 세 번 부르므로 분당 20번 조작해야 닿는다. 상태는 프로세스 안에만 있고
# (워커마다 따로 센다) 재시작하면 초기화된다.
MAREUNGIL_RATE_LIMIT=60
MAREUNGIL_RATE_WINDOW_SEC=60

# 앞에 둔 **신뢰하는** 프록시 단수. 0 이면 X-Forwarded-For 를 아예 믿지 않는다.
#
# 로컬은 0 이 맞다. Render 처럼 프록시 뒤에 놓을 때만 1 로 준다 — 프록시 뒤인데
# 0 이면 모든 요청이 프록시 IP 하나로 뭉치고, 프록시가 없는데 1 이면 클라이언트가
# 적어 보낸 값을 믿게 되어 한도를 우회당한다.
MAREUNGIL_TRUSTED_PROXY_HOPS=0

# --- 프론트엔드 (Vite 는 VITE_ 접두사만 번들에 노출한다) ---------------------

# 백엔드 주소. 비워두면 web/vite.config.ts 의 프록시(/api)를 쓴다.
VITE_API_BASE=

# --- 사전 수집 스크립트 (런타임 아님) ---------------------------------------
#
# 서울 열린데이터광장 OpenAPI 키는 환경변수가 아니라
# secrets/seoul_openapi_key.txt 파일에서 읽는다. 여기에 적지 않는다.
# 두 외부 서비스 모두 "사전 1회" 수집용이며 데모 런타임에는 호출하지 않는다.
